# Copia este archivo a .env dentro de cadence/ y completa los valores reales.
# .env NUNCA debe subirse al repositorio (ya esta en .gitignore).

# --- Google Gemini (vision) ---
GEMINI_API_KEY=
# Verifica el id vigente del modelo Flash Lite en https://ai.google.dev/gemini-api/docs/models
# antes de desplegar; los nombres de modelo de Gemini cambian con el tiempo.
GEMINI_MODEL=gemini-flash-lite-latest

# --- wger REST API ---
# La instancia de wger ya desplegada (ver README de infraestructura en la raiz del repo).
WGER_BASE_URL=https://crm-wger.cjauws.easypanel.host
# Generar en wger: menu de usuario -> API key, o /en/user/api-key
WGER_API_TOKEN=
# 2 = ingles, en las fixtures por defecto de wger. Ajusta si tu instancia usa otro idioma.
WGER_LANGUAGE_ID=2

# --- Comportamiento ---
# Nombre que se muestra en el saludo del inicio.
USER_NAME=Andrés
# Zona horaria IANA: define que es "hoy" y a que comida (desayuno/almuerzo/...) pertenece cada registro.
TIMEZONE=America/Panama
MATCH_CANDIDATE_COUNT=3
# Opcional: fuerza un nutrition plan especifico en vez de usar el mas reciente del usuario.
DEFAULT_NUTRITION_PLAN_ID=

# --- Recetas (TheMealDB) ---
# Recetas y fotos reales. "1" es la clave gratuita de desarrollo; para publicar la app en una tienda
# hay que comprar su clave de apoyo (pago unico) y ponerla aqui. Sin pasos en el servidor: se descargan solas.
MEALDB_API_KEY=1
# false = no descargar ni preparar recetas en segundo plano.
RECIPES_SYNC=true
# Pausa entre recetas mientras se prepara el recetario (una llamada a Gemini por receta, unas 790 en total, una sola vez).
RECIPES_PREP_SECONDS=20
